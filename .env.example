KINOPUB_CLIENT_ID=
KINOPUB_CLIENT_SECRET=
KINOPUB_API_BASE=https://api.service-kp.com
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080
# Для production обязательно перечислите разрешённые CDN-домены без схемы:
# STREAM_HOST_SUFFIXES=service-kp.com,kino.pub,example-cdn.net
STREAM_HOST_SUFFIXES=
# При необходимости CDN может ожидать эти заголовки:
MEDIA_REFERER=
MEDIA_ORIGIN=

# Poster/backdrop proxy
IMAGE_REFERER=https://kino.watch/
IMAGE_MAX_BYTES=8388608

# Temporary HLS for selected audio tracks
AUDIO_HLS_TTL=3600
AUDIO_HLS_SEGMENT_SECONDS=4
AUDIO_HLS_START_BUCKET=10
