KINOPUB_CLIENT_ID=
KINOPUB_CLIENT_SECRET=
KINOPUB_API_BASE=https://api.service-kp.com
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080
# Белый список хостов, которые разрешено проксировать (без схемы, совпадение
# по суффиксу - домена второго уровня достаточно).
#
# Пустое значение = разрешено всё. Заполненное = всё остальное получает 403,
# включая постеры и видео. Здесь перечислены РЕАЛЬНЫЕ хосты KinoPub:
# staticpop.net отдаёт постеры, cdntogo.net - видео. Не заменяйте их
# вымышленными: пропущенный cdntogo.net ломает Relay и HLS, а пропущенный
# staticpop.net оставляет каталог без обложек. Direct при этом продолжает
# играть, потому что идёт мимо прокси - из-за чего причину ищут долго.
STREAM_HOST_SUFFIXES=service-kp.com,kino.pub,staticpop.net,cdntogo.net
# При необходимости CDN может ожидать эти заголовки:
MEDIA_REFERER=
MEDIA_ORIGIN=

# Poster/backdrop proxy
IMAGE_REFERER=https://kino.watch/
IMAGE_MAX_BYTES=8388608

# Temporary HLS for selected audio tracks
AUDIO_HLS_TTL=3600
AUDIO_HLS_SEGMENT_SECONDS=4
AUDIO_HLS_START_BUCKET=10

# Сборка бэкенда с FFmpeg или без него.
#   1 - как раньше: ffmpeg ставится в образ, доступна пересборка звуковой
#       дорожки на сервере (последняя ступень выбора аудио в плеере).
#   0 - образ вообще без ffmpeg: меньше и собирается заметно быстрее.
#       Каталог, воспроизведение (direct/relay/HLS), субтитры и первые три
#       способа переключить звук (дорожки в манифесте, родные дорожки MP4,
#       другой HLS-вариант) работают как обычно; недоступна только
#       пересборка дорожки, которой в потоке нет. Плеер об этом знает и
#       пишет причину вместо неудачной попытки.
# Меняется только пересборкой: docker compose up -d --build backend
WITH_FFMPEG=1
