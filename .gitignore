.env
rebuild_containers.bat
# Saved kino.watch pages: 14 MB of third-party assets, and each one carries a
# live csrf-token from the session they were saved in.
examples/
# frontend/tests/: npm install artifacts and the regenerated preview page
frontend/tests/node_modules/
frontend/tests/preview.html
ignore
# Личные настройки Claude Code: персональные разрешения конкретной машины,
# файл заводится сам.
.claude/settings.local.json
# Выгрузки рабочей базы: внутри sessions с access_token и refresh_token
# KinoPub. Одна такая выгрузка уже уехала на GitHub и потребовала
# переписывания истории с отзывом устройства - держите подобные файлы вне
# каталога репозитория, а не надейтесь на этот список.
kp-transfer.db
*.db
# Рабочее состояние обновлятора: status.json пишет скрипт на хосте,
# requested создаёт приложение. Это состояние конкретной установки, а не
# часть проекта. Сам каталог создаётся при первом запуске.
update/
__pycache__/
*.pyc
